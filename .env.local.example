# PYBF v1 환경 변수 템플릿
# 실제 값은 .env.local 에 채우고 (gitignore됨), Vercel 환경 변수에도 동일하게 등록.

# ===== Anthropic Claude API =====
# https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ===== Supabase =====
# https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ===== Meta (Instagram · Facebook · Threads) =====
# https://developers.facebook.com/ → 앱 settings → Basic
META_APP_ID=
META_APP_SECRET=
# 권한 심사 통과 후 OAuth 흐름으로 발급되는 토큰은 DB(channel_credentials)에 저장.
# 아래는 개발용 short-lived 토큰 또는 system user 토큰을 임시로 사용할 때만.
# META_DEV_ACCESS_TOKEN=

# ===== Naver Band =====
# https://developers.naver.com/main/ → 애플리케이션
BAND_CLIENT_ID=
BAND_CLIENT_SECRET=
# 본인 밴드 ID — OAuth 후 list_band API 호출 또는 밴드 URL에서 확인
BAND_TARGET_ID=

# ===== App config =====
# DRY_RUN=true 면 SNS publish 호출이 가짜 post_url 반환 (메타 심사 통과 전 개발용)
DRY_RUN=true
